# Configuration de l'application NoteFlow
# Copier ce fichier en .env et modifier les valeurs selon votre environnement

# Port de l'application
PORT=2222

# Secret JWT (optionnel) - valeur forte et aléatoire
# Si vide, un secret aléatoire est généré au premier démarrage et persisté en base.
# Générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Mot de passe PostgreSQL (OBLIGATOIRE avec docker-compose)
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=remplacez_par_un_mot_de_passe_fort

# Mot de passe du compte "admin" créé lors de la première installation (optionnel)
# Si vide, un mot de passe aléatoire est généré et affiché une seule fois dans les logs du conteneur.
# Sans effet sur une installation existante.
ADMIN_PASSWORD=

# Environnement (development, production)
NODE_ENV=production

# Chemins des fichiers
DB_PATH=/app/data/notes.db
UPLOADS_PATH=/app/public/uploads

# Limite de taille des uploads (en bytes)
MAX_FILE_SIZE=5242880

# Limite de taux (requests par fenêtre)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# URL de l'application (IMPORTANT pour Google OAuth)
# En local: http://localhost:2222
# En production: https://votre-domaine.com (sans slash final)
APP_URL=http://localhost:2222

# CORS - Configuration des origines autorisées
# IMPORTANT: En production, les requêtes cross-origin sont REFUSÉES si non configuré
# Définir l'URL du frontend si différent du backend
# Exemple: CORS_ORIGIN=https://app.noteflow.fr
CORS_ORIGIN=
